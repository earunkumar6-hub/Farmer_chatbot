# Copy this file to ".env" in the PROJECT ROOT (same folder as requirements.txt).
# Only the backend reads this — the key never touches the Streamlit frontend
# or the browser.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown):
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# RETRIEVER_K=4
